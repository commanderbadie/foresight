# Copy to .env and adjust.

# SQLite (zero setup) is the default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://foresight:foresight@localhost:5432/foresight
DATABASE_URL=sqlite:///./foresight.db

# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Trained TAWOS model (created by ml/train.py). If missing, the synthetic demo model is used.
MODEL_PATH=models/tawos/model.joblib
DEMO_MODEL_PATH=models/demo/model.joblib

# Local LLM via Ollama (free). Without Ollama the assistant runs in offline rule mode.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct
LLM_TIMEOUT_SECONDS=60
